# ---------------------------------------------------------------
# Student Expressoo API — environment configuration
# Copy to server/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MySQL 8 connection string (illustrative values — not real credentials).
# connection_limit sets the Prisma connection pool size.
DATABASE_URL="mysql://root:hemkumar@localhost:3306/student_expressoo?connection_limit=10"

# Separate database used only by `npm test` (it is wiped on every run).
TEST_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/student_expressoo_test"

# Long random secret (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=abcheed344325
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Set to 1 when running behind a reverse proxy / load balancer (for correct client IPs).
TRUST_PROXY=0

# File uploads (study materials)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Academic rules
APP_TIMEZONE=Asia/Kolkata
ATTENDANCE_THRESHOLD=75
ATTENDANCE_EDIT_WINDOW_DAYS=7
MAX_PERIODS_PER_DAY=8
ALERT_ESCALATION_MINUTES=2
