# Public, non-secret defaults for the Student Portal (bundled into the browser build).
# Never put passwords, database URLs or API secrets in VITE_ variables.
# Override per machine in .env.local, or per deployment in .env.production / host build variables.
VITE_API_URL=http://localhost:5000/api/v1

# Links to the other portals (shown on the sign-in page). Remove a line to hide that link.
VITE_STUDENT_URL=http://localhost:5173
VITE_STAFF_URL=http://localhost:5174
VITE_ADMIN_URL=http://localhost:5175
